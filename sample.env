# Example environment file. Copy it to .env and replace every placeholder.
# Never commit the real .env file or actual course flags.
MARIADB_ROOT_PASSWORD=REPLACE_THIS_STRING_WITH_ROOT_PASSWORD
MARIADB_USER=tatou
MARIADB_PASSWORD=REPLACE_THIS_STRING_WITH_PASSWORD
FLAG_1=REPLACE_THIS_STRING_WITH_SERVER_FLAG
FLAG_2=REPLACE_THIS_STRING_WITH_SERVER_FLAG
# Generate a private value with: python -c "import secrets; print(secrets.token_hex(32))"
# Put the generated value in .env only; keep this template empty.
SECRET_KEY=
# Maximum accepted PDF size in bytes (64 MiB by default).
MAX_UPLOAD_SIZE_BYTES=67108864
# Grafana admin credentials
GF_USERNAME=admin
GF_PASSWORD=REPLACE_THIS_STRING_WITH_GRAFANA_PASSWORD
